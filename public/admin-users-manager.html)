<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>إدارة المشتركين والمستخدمين | الإدارة العليا</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;900&display=swap" rel="stylesheet"/>
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet"/>
  <style> body { font-family: 'Cairo', sans-serif; background-color: #0b1320; color: #f8fafc; } </style>
</head>
<body class="min-h-screen p-4 sm:p-6 flex flex-col items-center">

  <div class="w-full max-w-5xl space-y-6">

    <!-- Header -->
    <header class="bg-slate-900 border border-amber-500/30 rounded-3xl p-5 shadow-2xl flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="flex items-center gap-3">
        <div class="w-12 h-12 bg-amber-500/10 text-amber-400 rounded-2xl flex items-center justify-center font-black text-xl border border-amber-500/20">👑</div>
        <div>
          <h1 id="portal-title" class="text-base font-black text-white">إدارة المشتركين ونظام الصلاحيات</h1>
          <p class="text-[11px] text-slate-400">لوحة تحكم إدارية مركزية (مؤسسة أكسجين)</p>
        </div>
      </div>
      <div class="flex items-center gap-2">
        <button onclick="openUserModal('add')" class="px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white rounded-xl text-xs font-bold transition flex items-center gap-1 shadow-md">
          <span class="material-symbols-outlined text-sm">person_add</span>
          <span>إضافة مشترك جديد</span>
        </button>
        <button onclick="window.location.replace('https://oxygen11.com')" class="px-4 py-2 bg-slate-800 hover:bg-slate-700 text-slate-300 rounded-xl text-xs font-bold transition">
          الرئيسية
        </button>
      </div>
    </header>

    <!-- Stats & Filters -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 text-right">
      <div class="bg-slate-900 border border-slate-800 p-4 rounded-2xl">
        <span class="text-[10px] text-slate-400 block font-bold">إجمالي المشتركين</span>
        <span id="stat-total" class="text-xl font-black text-white mt-1 block">0</span>
      </div>
      <div class="bg-slate-900 border border-slate-800 p-4 rounded-2xl">
        <span class="text-[10px] text-emerald-400 block font-bold">العملاء النشطون</span>
        <span id="stat-clients" class="text-xl font-black text-emerald-400 mt-1 block">0</span>
      </div>
      <div class="bg-slate-900 border border-slate-800 p-4 rounded-2xl">
        <span class="text-[10px] text-blue-400 block font-bold">الفنيون بالميدان</span>
        <span id="stat-techs" class="text-xl font-black text-blue-400 mt-1 block">0</span>
      </div>
      <div class="bg-slate-900 border border-slate-800 p-4 rounded-2xl">
        <span class="text-[10px] text-amber-400 block font-bold">المشرفون والمالك</span>
        <span id="stat-admins" class="text-xl font-black text-amber-400 mt-1 block">0</span>
      </div>
    </div>

    <!-- Users Table Card -->
    <div class="bg-slate-900 border border-slate-800 rounded-3xl overflow-hidden shadow-xl">
      <div class="p-4 border-b border-slate-800 flex items-center justify-between">
        <h3 class="text-xs font-bold text-slate-200">سجل المشتركين وقاعدة البيانات المركزية</h3>
        <span class="text-[10px] bg-slate-800 text-slate-400 px-2 py-0.5 rounded font-mono">تحديث فوري</span>
      </div>
      
      <div class="overflow-x-auto">
        <table class="w-full text-right text-xs">
          <thead class="bg-slate-800/60 text-slate-400 font-bold border-b border-slate-800">
            <tr>
              <th class="py-3 px-4">اسم المشترك</th>
              <th class="py-3 px-3">رقم الجوال</th>
              <th class="py-3 px-3 text-center">نوع الحساب / الدور</th>
              <th class="py-3 px-3 text-center">الرصيد / المحفظة</th>
              <th class="py-3 px-4 text-center">الإجراءات التشغيلية</th>
            </tr>
          </thead>
          <tbody id="users-table-body" class="divide-y divide-slate-800/60 text-slate-300">
            <!-- Dynamically populated -->
          </tbody>
        </table>
      </div>
    </div>

  </div>

  <!-- Modal: Add / Edit User -->
  <div id="user-modal" class="hidden fixed inset-0 z-50 bg-slate-950/80 backdrop-blur-xs flex items-center justify-center p-4">
    <div class="bg-slate-900 border border-slate-700 rounded-3xl p-6 w-full max-w-md space-y-4 shadow-2xl relative text-right">
      <h3 id="modal-title" class="text-sm font-bold text-white">إضافة مشترك جديد</h3>
      
      <input type="hidden" id="edit-original-phone"/>

      <div class="space-y-3 text-xs">
        <div>
          <label class="block text-slate-400 mb-1 font-bold">الاسم الكامل:</label>
          <input id="modal-name" type="text" class="w-full bg-slate-800 border border-slate-700 rounded-xl p-2.5 text-white outline-none focus:border-amber-500 font-bold"/>
        </div>
        <div>
          <label class="block text-slate-400 mb-1 font-bold">رقم الجوال (المعرف الأساسي):</label>
          <input id="modal-phone" type="tel" placeholder="05XXXXXXXX" class="w-full bg-slate-800 border border-slate-700 rounded-xl p-2.5 text-white outline-none focus:border-amber-500 font-bold font-mono"/>
        </div>
        <div>
          <label class="block text-slate-400 mb-1 font-bold">الرقم السري:</label>
          <input id="modal-password" type="text" class="w-full bg-slate-800 border border-slate-700 rounded-xl p-2.5 text-white outline-none focus:border-amber-500 font-bold font-mono"/>
        </div>
        <div>
          <label class="block text-slate-400 mb-1 font-bold">نوع الحساب / الدور:</label>
          <select id="modal-role" class="w-full bg-slate-800 border border-slate-700 rounded-xl p-2.5 text-white outline-none focus:border-amber-500 font-bold">
            <option value="client">عميل (Client)</option>
            <option value="tech">فني / مزود خدمة (Technician)</option>
            <option value="supervisor">مشرف ميداني (Supervisor)</option>
            <option value="owner">المالك (Owner)</option>
          </select>
        </div>
        <div>
          <label class="block text-slate-400 mb-1 font-bold">الرصيد الافتتاحي (ر.س):</label>
          <input id="modal-wallet" type="number" value="0.00" class="w-full bg-slate-800 border border-slate-700 rounded-xl p-2.5 text-white outline-none focus:border-amber-500 font-bold font-mono"/>
        </div>
      </div>

      <div class="flex items-center gap-2 pt-2">
        <button onclick="saveUserFromModal()" class="flex-1 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white rounded-xl font-bold text-xs transition shadow-md">
          حفظ البيانات
        </button>
        <button onclick="closeUserModal()" class="py-2.5 px-4 bg-slate-800 hover:bg-slate-700 text-slate-300 rounded-xl font-bold text-xs transition">
          إلغاء
        </button>
      </div>
    </div>
  </div>

  <!-- JavaScript Management Engine -->
  <script>
    const STORAGE_USERS_KEY = 'motqan_registered_users';
    let currentUserRole = 'owner';

    // التحقق من صلاحيات المالك أو المشرف فور فتح الواجهة
    (function verifyAdminAccess() {
      const session = JSON.parse(localStorage.getItem('motqan_active_session') || '{}');
      if (!session.role || (session.role !== 'owner' && session.role !== 'supervisor')) {
        alert('غير مسموح بالدخول لهذه الصفحة إلا للمالك أو المشرفين');
        window.location.replace('https://oxygen11.com');
        return;
      }
      currentUserRole = session.role;
      if (currentUserRole === 'supervisor') {
        document.getElementById('portal-title').textContent = 'لوحة إدارة المشتركين (المشرف الميداني)';
      }
      loadUsersTable();
    })();

    function getUsersDB() {
      try {
        return JSON.parse(localStorage.getItem(STORAGE_USERS_KEY)) || {};
      } catch (e) {
        return {};
      }
    }

    function saveUsersDB(db) {
      localStorage.setItem(STORAGE_USERS_KEY, JSON.stringify(db));
    }

    function loadUsersTable() {
      const users = getUsersDB();
      const tbody = document.getElementById('users-table-body');
      tbody.innerHTML = '';

      let total = 0, clients = 0, techs = 0, admins = 0;

      const roleLabels = {
        client: { name: 'عميل', color: 'bg-emerald-500/10 text-emerald-400 border-emerald-500/20' },
        tech: { name: 'فني ميداني', color: 'bg-blue-500/10 text-blue-400 border-blue-500/20' },
        supervisor: { name: 'مشرف', color: 'bg-amber-500/10 text-amber-400 border-amber-500/20' },
        owner: { name: 'المالك', color: 'bg-purple-500/10 text-purple-400 border-purple-500/20' }
      };

      Object.keys(users).forEach(phone => {
        const u = users[phone];
        total++;
        if (u.role === 'client') clients++;
        else if (u.role === 'tech') techs++;
        else admins++;

        const badge = roleLabels[u.role] || roleLabels.client;
        const wallet = u.wallet || 0.00;

        tbody.innerHTML += `
          <tr class="hover:bg-slate-800/40 transition">
            <td class="py-3 px-4 font-bold text-white">${u.name || 'بدون اسم'}</td>
            <td class="py-3 px-3 font-mono text-slate-400">${u.phone}</td>
            <td class="py-3 px-3 text-center">
              <span class="px-2.5 py-1 rounded-full text-[10px] font-bold border ${badge.color}">${badge.name}</span>
            </td>
            <td class="py-3 px-3 text-center font-mono font-bold text-emerald-400">${wallet.toFixed(2)} ر.س</td>
            <td class="py-3 px-4 text-center space-x-1 space-x-reverse">
              <button onclick="openUserModal('edit', '${u.phone}')" class="px-2.5 py-1 bg-slate-800 hover:bg-slate-700 text-slate-300 rounded-lg text-[11px] font-bold transition">تعديل</button>
              <button onclick="addBalance('${u.phone}')" class="px-2.5 py-1 bg-emerald-600/20 hover:bg-emerald-600/30 text-emerald-400 rounded-lg text-[11px] font-bold transition">رصيد+</button>
              ${currentUserRole === 'owner' ? `<button onclick="deleteUser('${u.phone}')" class="px-2.5 py-1 bg-red-500/10 hover:bg-red-500/20 text-red-400 rounded-lg text-[11px] font-bold transition">حذف</button>` : ''}
            </td>
          </tr>
        `;
      });

      document.getElementById('stat-total').textContent = total;
      document.getElementById('stat-clients').textContent = clients;
      document.getElementById('stat-techs').textContent = techs;
      document.getElementById('stat-admins').textContent = admins;
    }

    function openUserModal(mode, phone = '') {
      const modal = document.getElementById('user-modal');
      const title = document.getElementById('modal-title');
      modal.classList.remove('hidden');

      if (mode === 'edit' && phone) {
        const users = getUsersDB();
        const u = users[phone];
        if (u) {
          title.textContent = 'تعديل بيانات المشترك';
          document.getElementById('edit-original-phone').value = u.phone;
          document.getElementById('modal-name').value = u.name;
          document.getElementById('modal-phone').value = u.phone;
          document.getElementById('modal-password').value = u.password;
          document.getElementById('modal-role').value = u.role;
          document.getElementById('modal-wallet').value = u.wallet || 0;
        }
      } else {
        title.textContent = 'إضافة مشترك جديد';
        document.getElementById('edit-original-phone').value = '';
        document.getElementById('modal-name').value = '';
        document.getElementById('modal-phone').value = '';
        document.getElementById('modal-password').value = '';
        document.getElementById('modal-role').value = 'client';
        document.getElementById('modal-wallet').value = '0.00';
      }
    }

    function closeUserModal() {
      document.getElementById('user-modal').classList.add('hidden');
    }

    function saveUserFromModal() {
      const origPhone = document.getElementById('edit-original-phone').value;
      const name = document.getElementById('modal-name').value.trim();
      const phone = document.getElementById('modal-phone').value.trim();
      const password = document.getElementById('modal-password').value.trim();
      const role = document.getElementById('modal-role').value;
      const wallet = parseFloat(document.getElementById('modal-wallet').value) || 0;

      if (!phone || !password) {
        alert('يرجى إدخال رقم الجوال وكلمة المرور على الأقل');
        return;
      }

      const users = getUsersDB();

      // لو تم تغيير رقم الجوال في وضع التعديل، نحذف القديم
      if (origPhone && origPhone !== phone) {
        delete users[origPhone];
      }

      users[phone] = {
        name: name || 'مشترك جديد',
        phone: phone,
        password: password,
        role: role,
        wallet: wallet
      };

      saveUsersDB(users);
      closeUserModal();
      loadUsersTable();
      alert('تم حفظ بيانات المشترك بنجاح ✓');
    }

    function deleteUser(phone) {
      if (confirm(`هل أنت متأكد من حذف الحساب رقم (${phone}) نهائياً؟`)) {
        const users = getUsersDB();
        delete users[phone];
        saveUsersDB(users);
        loadUsersTable();
      }
    }

    function addBalance(phone) {
      const amount = prompt('أدخل المبلغ المراد إضافته لمحفظة العميل (ر.س):', '50');
      if (amount && !isNaN(amount)) {
        const users = getUsersDB();
        if (users[phone]) {
          users[phone].wallet = (users[phone].wallet || 0) + parseFloat(amount);
          saveUsersDB(users);
          loadUsersTable();
          alert(`تمت إضافة ${amount} ر.س بنجاح لرصيد المشترك.`);
        }
      }
    }
  </script>
</body>
</html>
